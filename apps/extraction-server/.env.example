EXTRACTION_SERVER_BIND=127.0.0.1:4100
DATABASE_URL=postgres://localhost/voxelize_extraction
EXTRACTION_PUBLIC_ORIGIN=http://127.0.0.1:5173
EXTRACTION_SIWE_DOMAIN=127.0.0.1:5173
EXTRACTION_SIWE_URI=http://127.0.0.1:5173
EXTRACTION_COOKIE_SECURE=false
EXTRACTION_AUTH_LOGIN_ENABLED=true
EXTRACTION_MATCHMAKING_ENABLED=true
# EOA 登录不使用 RPC；智能钱包登录需要 Ethereum Mainnet RPC。
EXTRACTION_ETHEREUM_RPC_URL=

# 独立的 loopback 只读运维进程，默认关闭；数据库账号必须仅有目标表 SELECT 权限。
EXTRACTION_OPS_ENABLED=false
EXTRACTION_OPS_BIND=127.0.0.1:4101
EXTRACTION_OPS_DATABASE_URL=
EXTRACTION_OPS_TOKEN=
EXTRACTION_OPS_QUERY_TIMEOUT_MS=2000
EXTRACTION_OPS_REQUESTS_PER_MINUTE=60
